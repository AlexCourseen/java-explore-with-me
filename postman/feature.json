							"listen": "prerequest",
							"script": {
								"exec": [
									"// 1. Генерация случайного email для предотвращения конфликтов уникальности",
									"const randomId = Math.floor(Math.random() * 10000);",
									"const uniqueEmail = `user_${randomId}.petrov@practicummail.ru`;",
									"",
									"// 2. Создание пользователя (Admin)",
									"pm.sendRequest({",
									"    url: 'http://localhost:8080/admin/users',",
									"    method: 'POST',",
									"    header: { 'Content-Type': 'application/json' },",
									"    body: {",
									"        mode: 'raw',",
									"        raw: JSON.stringify({",
									"            \"email\": uniqueEmail,",
									"            \"name\": \"Jphnв3323ввв Петров\"",
									"        })",
									"    }",
									"}, function (err, res) {",
									"    if (err) { console.error('Ошибка создания пользователя:', err); return; }",
									"    ",
									"    const user = res.json();",
									"    const userId = user.id;",
									"    pm.environment.set(\"userId\", userId);",
									"    console.log(`Пользователь создан с ID: ${userId}`);",
									"",
									"    // 3. Создание категории (Admin)",
									"    pm.sendRequest({",
									"        url: 'http://localhost:8080/admin/categories',",
									"        method: 'POST',",
									"        header: { 'Content-Type': 'application/json' },",
									"        body: {",
									"            mode: 'raw',",
									"            raw: JSON.stringify({",
									"                \"name\": \"Чай\" + randomId",
									"            })",
									"        }",
									"    }, function (err, res) {",
									"        if (err) { console.error('Ошибка создания категории:', err); return; }",
									"        ",
									"        const category = res.json();",
									"        const categoryId = category.id;",
									"        console.log(`Категория создана с ID: ${categoryId}`);",
									"",
									"        // 4. Создание события пользователем (Private)",
									"        pm.sendRequest({",
									"            url: `http://localhost:8080/users/${userId}/events`,",
									"            method: 'POST',",
									"            header: { 'Content-Type': 'application/json' },",
									"            body: {",
									"                mode: 'raw',",
									"                raw: JSON.stringify({",
									"                    \"annotation\": \"С323232323232плав на байдарках похож на полет.\",",
									"                    \"category\": categoryId, // Подставляем ID созданной категории",
									"                    \"description\": \"Сплав на байдарках похож на полет. На спокойной воде — это парение. На бурной, порожистой — выполнение фигур высшего пилотажа. И то, и другое дарят чувство обновления, феерические эмоции, яркие впечатления.\",",
									"                    \"eventDate\": \"2027-12-31 15:10:05\",",
									"                    \"location\": {",
									"                        \"lat\": 56.754167,",
									"                        \"lon\": 40.62",
									"                    },",
									"                    \"paid\": true,",
									"                    \"participantLimit\": 10,",
									"                    \"requestModeration\": false,",
									"                    \"title\": \"Сплав на байдарках\"",
									"                })",
									"            }",
									"        }, function (err, res) {",
									"            if (err) { console.error('Ошибка создания события:', err); return; }",
									"            ",
									"            const event = res.json();",
									"            const eventId = event.id;",
									"            pm.environment.set(\"eventId\", eventId);",
									"            console.log(`Событие создано с ID: ${eventId}`);",
									"",
									"            // 5. Публикация события администратором (Admin)",
									"            pm.sendRequest({",
									"                url: `http://localhost:8080/admin/events/${eventId}`, // Подставляем ID созданного события",
									"                method: 'PATCH',",
									"                header: { 'Content-Type': 'application/json' },",
									"                body: {",
									"                    mode: 'raw',",
									"                    raw: JSON.stringify({",
									"                        \"stateAction\": \"PUBLISH_EVENT\"",
									"                    })",
									"                }",
									"            }, function (err, res) {",
									"                if (err) { console.error('Ошибка публикации события:', err); return; }",
									"                console.log(`Событие ${eventId} успешно опубликовано.`);",
									"            });",
									"        });",
									"    });",
									"});",
									""
								],
